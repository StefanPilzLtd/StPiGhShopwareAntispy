<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="false" public="false"/>

        <service id="StPiGh\ShopwareAntispy\Service\AntispyConfig"/>

        <service id="StPiGh\ShopwareAntispy\Service\PrivacyStateInstaller" public="true"/>

        <service id="StPiGh\ShopwareAntispy\Subscriber\AdminPrivacySubscriber">
            <argument>%shopware_administration.path_name%</argument>
            <argument type="service" id="StPiGh\ShopwareAntispy\Service\AntispyConfig"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="StPiGh\ShopwareAntispy\Subscriber\ConfigToggleSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <!--
            Configurable channels: the original client stays available as
            ".inner" and is only used when the shop owner opted in via the
            plugin configuration. Default (no config value) blocks.
        -->
        <service id="stpigh_antispy.blocking.store_client"
                 class="StPiGh\ShopwareAntispy\Http\BlockingGuzzleClient"
                 decorates="shopware.store_client" public="true" lazy="true">
            <argument type="service" id="stpigh_antispy.blocking.store_client.inner"/>
            <argument type="service" id="StPiGh\ShopwareAntispy\Service\AntispyConfig"/>
            <argument type="constant">StPiGh\ShopwareAntispy\Service\AntispyConfig::ALLOW_STORE_COMMUNICATION</argument>
        </service>

        <service id="stpigh_antispy.blocking.frw_client"
                 class="StPiGh\ShopwareAntispy\Http\BlockingGuzzleClient"
                 decorates="shopware.frw_client" public="true" lazy="true">
            <argument type="service" id="stpigh_antispy.blocking.frw_client.inner"/>
            <argument type="service" id="StPiGh\ShopwareAntispy\Service\AntispyConfig"/>
            <argument type="constant">StPiGh\ShopwareAntispy\Service\AntispyConfig::ALLOW_STORE_COMMUNICATION</argument>
        </service>

        <service id="stpigh_antispy.blocking.store_download_client"
                 class="StPiGh\ShopwareAntispy\Http\BlockingGuzzleClient"
                 decorates="shopware.store_download_client" public="true">
            <argument type="service" id="stpigh_antispy.blocking.store_download_client.inner"/>
            <argument type="service" id="StPiGh\ShopwareAntispy\Service\AntispyConfig"/>
            <argument type="constant">StPiGh\ShopwareAntispy\Service\AntispyConfig::ALLOW_STORE_COMMUNICATION</argument>
        </service>

        <service id="stpigh_antispy.blocking.app_system_client"
                 class="StPiGh\ShopwareAntispy\Http\BlockingGuzzleClient"
                 decorates="shopware.app_system.guzzle" lazy="true">
            <argument type="service" id="stpigh_antispy.blocking.app_system_client.inner"/>
            <argument type="service" id="StPiGh\ShopwareAntispy\Service\AntispyConfig"/>
            <argument type="constant">StPiGh\ShopwareAntispy\Service\AntispyConfig::ALLOW_APP_SERVER_COMMUNICATION</argument>
        </service>

        <!--
            Non-negotiable channels: telemetry, usage data (GMV, orders,
            entity sync) and the service registry are always blocked and
            intentionally have no configuration toggle.
        -->
        <!--
            Shared Symfony http_client: requests to Shopware, fos.gg and
            Cloudflare hosts are blocked, all other hosts pass through.
        -->
        <service id="stpigh_antispy.host_filtering.http_client"
                 class="StPiGh\ShopwareAntispy\Http\HostFilteringHttpClient"
                 decorates="http_client">
            <argument type="service" id="stpigh_antispy.host_filtering.http_client.inner"/>
        </service>

        <service id="shopware.usage_data.gateway.client" class="StPiGh\ShopwareAntispy\Http\BlockingHttpClient" public="true"/>
        <service id="service_registry.http_client" class="StPiGh\ShopwareAntispy\Http\BlockingHttpClient"/>
    </services>
</container>
