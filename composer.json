{
  "name": "stpi/stpigh-shopware-antispy",
  "description": "Blocks Shopware telemetry, services, GMV/analytics and third-party admin calls.",
  "version": "1.0.1",
  "type": "shopware-platform-plugin",
  "license": "proprietary",
  "authors": [
    {
      "name": "Stefan Pilz Ltd.",
      "email": "contact@stefanpilz.ltd",
      "homepage": "https://stefanpilz.ltd",
      "role": "Manufacturer"
    }
  ],
  "autoload": {
    "psr-4": {
      "StPiGh\\ShopwareAntispy\\": "src/"
    }
  },
  "extra": {
    "shopware-plugin-class": "StPiGh\\ShopwareAntispy\\StPiGhShopwareAntispy",
    "plugin-icon": "src/Resources/config/plugin.png",
    "label": {
      "de-DE": "StPiGh Shopware Antispy",
      "en-GB": "StPiGh Shopware Antispy"
