{
    "name": "stpi/stpigh-shopware-antispy",
    "description": "Restricts Shopware telemetry, usage-data transfers and selected external connections in self-hosted Shopware 6.7 shops. Optional Store and app exceptions.",
    "version": "1.2.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "keywords": [
        "shopware",
        "shopware6",
        "shopware-plugin",
        "privacy",
        "telemetry",
        "tracking",
        "usage-data",
        "administration"
    ],
    "homepage": "https://stefanpilz.ltd",
    "authors": [
        {
            "name": "Stefan Pilz Ltd.",
            "email": "contact@stefanpilz.ltd",
            "homepage": "https://stefanpilz.ltd",
            "role": "Manufacturer"
        }
    ],
    "support": {
        "email": "plugins@stefanpilz.ltd",
        "issues": "https://github.com/StefanPilzLtd/StPiGhShopwareAntispy/issues",
        "source": "https://github.com/StefanPilzLtd/StPiGhShopwareAntispy"
    },
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "shopware/core": "~6.7.0",
        "shopware/administration": "~6.7.0"
    },
    "autoload": {
        "psr-4": {
            "StPiGh\\ShopwareAntispy\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "StPiGh\\ShopwareAntispy\\StPiGhShopwareAntispy",
        "plugin-icon": "src/Resources/config/plugin.png",
        "label": {
            "de-DE": "StPiGh Shopware Antispy",
            "en-GB": "StPiGh Shopware Antispy"
        },
        "description": {
            "de-DE": "Schränkt Shopware-Telemetrie, Nutzungsdatenübertragung und ausgewählte externe Verbindungen ein. Store- und App-Ausnahmen konfigurierbar; Updates und Integrationen gesondert prüfen.",
            "en-GB": "Restricts Shopware telemetry, usage-data transfers and selected external connections. Configurable Store and app exceptions; review updates and integrations separately."
        },
        "manufacturerLink": {
            "de-DE": "https://stefanpilz.ltd",
            "en-GB": "https://stefanpilz.ltd"
        },
        "supportLink": {
            "de-DE": "https://stefanpilz.ltd",
            "en-GB": "https://stefanpilz.ltd"
        }
    }
}
